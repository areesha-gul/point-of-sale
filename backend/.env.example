# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Security
SESSION_SECRET=change-this-to-a-random-secret-key-in-production

# Database
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10

# Backup
BACKUP_PATH=./backups

# CORS - Frontend URL (for production)
# Development: http://localhost:5173
# Production: https://your-frontend-url.vercel.app
FRONTEND_URL=http://localhost:5173

# ==========================================
# RENDER DEPLOYMENT NOTES:
# ==========================================
# 1. SESSION_SECRET: Use "Generate Value" in Render dashboard
# 2. DATABASE_URL: Set the Supabase Session Pooler URI
# 3. FRONTEND_URL: Set to your Vercel deployment URL
# 4. NODE_ENV: Set to production
# 5. PORT: Render sets this automatically, don't override
