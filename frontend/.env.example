# Frontend Environment Variables

# API Configuration
# Development: Leave empty or use /api (proxied by Vite)
# Production: Set to your Render backend URL
VITE_API_URL=

# ==========================================
# VERCEL DEPLOYMENT NOTES:
# ==========================================
# In Vercel Dashboard:
# 1. Go to Project Settings → Environment Variables
# 2. Add: VITE_API_URL = https://your-backend-url.onrender.com/api
# 3. Save and redeploy
#
# Example: VITE_API_URL=https://pos-backend-abcd.onrender.com/api
